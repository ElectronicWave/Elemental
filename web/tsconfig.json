{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [
        ".astro"
      ]
    }
  ]
}