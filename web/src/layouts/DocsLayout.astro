---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { DocGroup, DocMeta } from '../lib/docs';
import { SDK_META } from '../data/sdk';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  groups: readonly DocGroup[];
  activeSlug?: string;
  headings?: readonly MarkdownHeading[];
  prevDoc?: DocMeta | null;
  nextDoc?: DocMeta | null;
  sourcePath?: string;
  readingMinutes?: number;
  hasMermaid?: boolean;
}

const {
  title,
  description,
  groups,
  activeSlug,
  headings = [],
  prevDoc = null,
  nextDoc = null,
  sourcePath,
  readingMinutes,
  hasMermaid = false,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description} activeNav="docs">
  <div class="container grid grid-cols-1 items-start gap-7 pt-9 md:grid-cols-[220px_minmax(0,1fr)] md:gap-10 xl:grid-cols-[248px_minmax(0,1fr)_220px]">
    <aside
      class="border-b border-border-subtle pb-5 md:sticky md:top-[calc(var(--nav-height)+28px)] md:max-h-[calc(100vh-var(--nav-height)-48px)] md:overflow-y-auto md:overscroll-contain md:border-b-0 md:pb-6"
      aria-label="Documentation navigation"
    >
      <a
        href={withBase('/docs/')}
        class:list={[
          'block rounded-lg border px-3 py-2 text-sm font-medium transition-colors',
          !activeSlug
            ? 'border-accent-border bg-accent-dim text-accent'
            : 'border-transparent text-fg-secondary hover:bg-surface hover:text-fg',
        ]}
      >
        Documentation Home
      </a>

      {groups.map((group) => (
        <div class="mt-6">
          <div class="px-3 pb-2 font-mono text-[11.5px] text-fg-muted">{group.name}</div>
          <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
            {group.items.map((item) => (
              <li>
                <a
                  href={withBase(`/docs/${item.slug}/`)}
                  class:list={[
                    'block rounded-lg border px-3 py-[7px] text-[13.5px] transition-colors',
                    activeSlug === item.slug
                      ? 'border-accent-border bg-raised text-fg'
                      : 'border-transparent text-fg-secondary hover:bg-surface hover:text-fg',
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="mt-6">
        <div class="px-3 pb-2 font-mono text-[11.5px] text-fg-muted">External References</div>
        <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
          <li>
            <a
              href={SDK_META.docsRsUrl}
              target="_blank"
              rel="noreferrer"
              class="block rounded-lg border border-transparent px-3 py-[7px] text-[13.5px] text-fg-secondary transition-colors hover:bg-surface hover:text-fg"
            >
              API Reference (docs.rs)
            </a>
          </li>
          <li>
            <a
              href={`${SDK_META.repositoryUrl}/blob/main/crates/shared/DESIGN.md`}
              target="_blank"
              rel="noreferrer"
              class="block rounded-lg border border-transparent px-3 py-[7px] text-[13.5px] text-fg-secondary transition-colors hover:bg-surface hover:text-fg"
            >
              Persistence Design
            </a>
          </li>
          <li>
            <a
              href={`${SDK_META.repositoryUrl}/blob/main/crates/object/DESIGN.md`}
              target="_blank"
              rel="noreferrer"
              class="block rounded-lg border border-transparent px-3 py-[7px] text-[13.5px] text-fg-secondary transition-colors hover:bg-surface hover:text-fg"
            >
              Object Pool Design
            </a>
          </li>
        </ul>
      </div>
    </aside>

    <article class="min-w-0">
      {sourcePath && (
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-border-subtle pb-3.5 font-mono text-xs text-fg-muted">
          <span class="rounded border border-accent-border bg-accent-dim px-2 py-0.5 text-accent">
            docs/{sourcePath}.md
          </span>
          <div class="flex items-center gap-4">
            {readingMinutes && <span class="tabular">{readingMinutes} min read</span>}
            <a
              href={`${SDK_META.repositoryUrl}/blob/main/docs/${sourcePath}.md`}
              target="_blank"
              rel="noreferrer"
              class="text-fg-secondary transition-colors hover:text-accent"
            >
              View source on GitHub
            </a>
          </div>
        </div>
      )}

      <div class="prose">
        <slot />
      </div>

      {(prevDoc || nextDoc) && (
        <nav class="mt-12 grid grid-cols-1 gap-4 border-t border-border-subtle pt-6 md:grid-cols-2" aria-label="Document pagination">
          {prevDoc ? (
            <a href={withBase(`/docs/${prevDoc.slug}/`)} class="corner-frame flex flex-col gap-1 px-[18px] py-4 transition-colors hover:border-accent-border">
              <span class="font-mono text-[11.5px] text-fg-muted">Previous</span>
              <span class="text-[14.5px] font-medium text-fg">{prevDoc.title}</span>
            </a>
          ) : (
            <div />
          )}

          {nextDoc ? (
            <a href={withBase(`/docs/${nextDoc.slug}/`)} class="corner-frame flex flex-col gap-1 px-[18px] py-4 text-right transition-colors hover:border-accent-border">
              <span class="font-mono text-[11.5px] text-fg-muted">Next</span>
              <span class="text-[14.5px] font-medium text-fg">{nextDoc.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )}
    </article>

    {tocHeadings.length > 0 && (
      <aside
        class="sticky top-[calc(var(--nav-height)+28px)] hidden max-h-[calc(100vh-var(--nav-height)-48px)] overflow-y-auto overscroll-contain pb-6 xl:block"
        aria-label="Table of contents"
      >
        <div class="mb-2.5 font-mono text-[11.5px] text-fg-muted">On this page</div>
        <ul class="m-0 flex list-none flex-col gap-1.5 border-l border-border-subtle p-0">
          {tocHeadings.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={[
                  '-ml-px block border-l-[1.5px] border-transparent py-0.5 text-[12.5px] leading-[1.45] text-fg-muted transition-colors hover:text-accent-soft [&.active]:border-l-accent [&.active]:text-accent',
                  h.depth === 3 ? 'pl-[22px]' : 'pl-3',
                ]}
                data-toc-link={h.slug}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  {tocHeadings.length > 0 && (
    <script>
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      if (tocLinks.length > 0) {
        const linkBySlug = new Map<string, HTMLAnchorElement>(
          tocLinks
            .map((link) => [link.dataset.tocLink ?? '', link] as const)
            .filter(([slug]) => slug.length > 0),
        );

        const headings = Array.from(linkBySlug.keys())
          .map((slug) => document.getElementById(slug))
          .filter((el): el is HTMLElement => el !== null);

        let activeSlug = '';
        const setActive = (slug: string) => {
          if (!slug || slug === activeSlug) return;
          activeSlug = slug;
          for (const [id, link] of linkBySlug) {
            link.classList.toggle('active', id === slug);
          }
        };

        if (headings.length > 0) {
          setActive(headings[0].id);

          const updateActiveHeading = () => {
            const offset = 112;
            let current = headings[0].id;
            for (const heading of headings) {
              if (heading.getBoundingClientRect().top <= offset) {
                current = heading.id;
              } else {
                break;
              }
            }
            setActive(current);
          };

          let ticking = false;
          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(() => {
              updateActiveHeading();
              ticking = false;
            });
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('hashchange', updateActiveHeading);
          updateActiveHeading();
        }
      }
    </script>
  )}

  {hasMermaid && (
    <script>
      const mermaidBlocks = Array.from(
        document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]'),
      );

      if (mermaidBlocks.length > 0) {
        const sources = mermaidBlocks.map((pre) => pre.textContent?.trim() ?? '');
        const containers: HTMLElement[] = mermaidBlocks.map((pre) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid-frame corner-frame';
          pre.replaceWith(wrapper);
          return wrapper;
        });

        let renderSeq = 0;

        const getMermaidThemeVariables = (isLight: boolean) =>
          isLight
            ? {
                darkMode: false,
                background: '#f4f4f5',
                primaryColor: '#ffffff',
                primaryTextColor: '#09090b',
                primaryBorderColor: '#09090b',
                lineColor: '#71717a',
                secondaryColor: '#f4f4f5',
                tertiaryColor: '#fafafa',
                fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
                fontSize: '13px',
              }
            : {
                darkMode: true,
                background: '#050505',
                primaryColor: '#121212',
                primaryTextColor: '#f5f5f5',
                primaryBorderColor: '#ffffff',
                lineColor: '#737373',
                secondaryColor: '#1a1a1a',
                tertiaryColor: '#101010',
                fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
                fontSize: '13px',
              };

        const renderDiagrams = async () => {
          if (document.fonts?.ready) {
            await document.fonts.ready;
          }
          const isLight = document.documentElement.dataset.theme === 'light';
          const { default: mermaid } = await import('mermaid');
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            themeVariables: getMermaidThemeVariables(isLight),
            flowchart: {
              htmlLabels: true,
              curve: 'basis',
              padding: 18,
              nodeSpacing: 44,
              rankSpacing: 48,
            },
          });

          const batchId = ++renderSeq;
          await Promise.all(
            sources.map(async (source, i) => {
              if (!source) return;
              try {
                const { svg } = await mermaid.render(`mermaid-graph-${batchId}-${i}`, source);
                containers[i].innerHTML = svg;
              } catch {
                containers[i].textContent = source;
              }
            }),
          );
        };

        void renderDiagrams();
        window.addEventListener('elemental-theme-change', () => {
          void renderDiagrams();
        });
      }
    </script>
  )}
</BaseLayout>
