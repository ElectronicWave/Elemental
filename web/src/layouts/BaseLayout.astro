---
import '../styles/global.css';
import { SDK_META } from '../data/sdk';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'docs';
}

const {
  title,
  description = 'A modular Rust toolkit for Minecraft launchers and reusable application infrastructure.',
  activeNav = 'home',
} = Astro.props;

const fullTitle = title === SDK_META.name ? `${SDK_META.name} — Modular Rust Minecraft Launcher SDK` : `${title} · ${SDK_META.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" id="theme-color-meta" content="#090909" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      (() => {
        const storageKey = 'elemental-theme';
        let theme = 'dark';
        try {
          const saved = localStorage.getItem(storageKey);
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch {
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        }
        document.documentElement.dataset.theme = theme;
        const meta = document.getElementById('theme-color-meta');
        if (meta) {
          meta.setAttribute('content', theme === 'light' ? '#fafafa' : '#090909');
        }
      })();
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="sticky top-0 z-50 h-[var(--nav-height)] border-b border-border-subtle bg-[var(--header-bg)] backdrop-blur-[14px]">
      <div class="container flex h-full items-center justify-between gap-3 md:gap-4 lg:gap-6">
        <a href={withBase('/')} class="inline-flex min-w-0 shrink-0 items-center gap-2 md:gap-2.5" aria-label="Elemental home">
          <img src={withBase('/favicon.svg')} width="24" height="24" alt="" aria-hidden="true" />
          <span class="whitespace-nowrap text-base font-semibold tracking-[-0.01em] text-fg">{SDK_META.name}</span>
          <span class="tabular hidden whitespace-nowrap rounded border border-border-subtle bg-surface px-1.5 py-0.5 font-mono text-xs text-fg-muted lg:inline-block">
            v{SDK_META.version}
          </span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          <a
            href={withBase('/')}
            class:list={[
              'whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors lg:px-3',
              activeNav === 'home'
                ? 'bg-raised text-fg shadow-[inset_0_1px_0_var(--inset-highlight)]'
                : 'text-fg-secondary hover:bg-surface hover:text-fg',
            ]}
          >
            Overview
          </a>
          <a
            href={withBase('/#getting-started')}
            class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-medium text-fg-secondary transition-colors hover:bg-surface hover:text-fg lg:px-3"
          >
            Get Started
          </a>
          <a
            href={withBase('/#crates')}
            class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-medium text-fg-secondary transition-colors hover:bg-surface hover:text-fg lg:px-3"
          >
            Crates
          </a>
          <a
            href={withBase('/docs/')}
            class:list={[
              'whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors lg:px-3',
              activeNav === 'docs'
                ? 'bg-raised text-fg shadow-[inset_0_1px_0_var(--inset-highlight)]'
                : 'text-fg-secondary hover:bg-surface hover:text-fg',
            ]}
          >
            Docs
          </a>
        </nav>

        <div class="flex shrink-0 items-center gap-2 md:gap-3">
          <button
            type="button"
            id="theme-toggle"
            class="inline-flex size-9 cursor-pointer items-center justify-center rounded-lg border border-border-subtle bg-surface text-fg-secondary transition-colors hover:border-border-default hover:bg-raised hover:text-fg md:size-[34px]"
            aria-label="Toggle color theme"
            title="Switch light / dark theme"
          >
            <svg class="[[data-theme='light']_&]:hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
            </svg>
            <svg class="hidden [[data-theme='light']_&]:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
          </button>

          <a
            href={SDK_META.docsRsUrl}
            target="_blank"
            rel="noreferrer"
            class="hidden items-center gap-1 font-mono text-[13px] text-fg-secondary transition-colors hover:text-accent-soft lg:inline-flex"
          >
            docs.rs
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <a
            href={SDK_META.repositoryUrl}
            target="_blank"
            rel="noreferrer"
            class="group btn btn-secondary btn-sm size-9 border-border-subtle bg-surface p-0 text-fg-secondary hover:border-border-default hover:bg-raised hover:text-fg md:w-auto md:gap-[7px] md:border-border-default md:bg-raised md:px-3.5 md:text-fg"
            aria-label="GitHub repository"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="hidden md:inline">GitHub</span>
            <span
              class="hidden items-center gap-1.5 font-mono text-xs text-fg-secondary md:inline-flex [&[hidden]]:hidden"
              id="gh-star-wrap"
              data-gh-star-wrap
              hidden
            >
              <span class="mx-0.5 h-[13px] w-px bg-border-default" aria-hidden="true"></span>
              <svg class="text-[#f5c451] transition-colors group-hover:text-[#fde047]" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
              </svg>
              <span class="tabular" id="gh-star-count" data-gh-star-count></span>
            </span>
          </a>

          <button
            type="button"
            id="mobile-menu-toggle"
            class="group inline-flex size-9 cursor-pointer items-center justify-center rounded-lg border border-border-subtle bg-surface text-fg-secondary transition-colors hover:border-border-default hover:bg-raised hover:text-fg md:hidden"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <svg class="group-aria-expanded:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
            <svg class="hidden group-aria-expanded:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <div
        id="mobile-nav"
        class="absolute inset-x-0 top-full z-50 max-h-[calc(100dvh-var(--nav-height))] overflow-y-auto border-b border-border-default bg-page shadow-[var(--elevated-shadow)] md:hidden [&[hidden]]:hidden"
        hidden
      >
        <div class="container flex flex-col gap-3 py-3 pb-4">
          <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
            <a
              href={withBase('/')}
              class:list={[
                'flex min-h-11 items-center rounded-lg border px-3 text-[15px] font-medium transition-colors',
                activeNav === 'home'
                  ? 'border-border-subtle bg-raised text-fg'
                  : 'border-transparent text-fg-secondary hover:bg-surface hover:text-fg',
              ]}
            >
              Overview
            </a>
            <a
              href={withBase('/#getting-started')}
              class="flex min-h-11 items-center rounded-lg border border-transparent px-3 text-[15px] font-medium text-fg-secondary transition-colors hover:bg-surface hover:text-fg"
            >
              Get Started
            </a>
            <a
              href={withBase('/#crates')}
              class="flex min-h-11 items-center rounded-lg border border-transparent px-3 text-[15px] font-medium text-fg-secondary transition-colors hover:bg-surface hover:text-fg"
            >
              Crates
            </a>
            <a
              href={withBase('/docs/')}
              class:list={[
                'flex min-h-11 items-center rounded-lg border px-3 text-[15px] font-medium transition-colors',
                activeNav === 'docs'
                  ? 'border-border-subtle bg-raised text-fg'
                  : 'border-transparent text-fg-secondary hover:bg-surface hover:text-fg',
              ]}
            >
              Docs
            </a>
          </nav>

          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border-subtle px-3 pt-3 font-mono text-[12.5px] text-fg-secondary">
            <a href={SDK_META.docsRsUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-8 items-center gap-1.5 transition-colors hover:text-fg">
              <span>docs.rs</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href={SDK_META.repositoryUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-8 items-center gap-1.5 transition-colors hover:text-fg">
              <span>GitHub</span>
              <span class="inline-flex items-center gap-1 font-mono text-xs text-fg-secondary [&[hidden]]:hidden" data-gh-star-wrap hidden>
                <svg class="text-[#f5c451]" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
                </svg>
                <span class="tabular" data-gh-star-count></span>
              </span>
            </a>
            <span class="tabular ml-auto rounded border border-border-subtle bg-surface px-1.5 py-0.5 text-xs text-fg-muted">
              v{SDK_META.version}
            </span>
          </div>
        </div>
      </div>
    </header>
    <div
      id="mobile-nav-backdrop"
      class="fixed inset-x-0 bottom-0 top-[var(--nav-height)] z-40 bg-black/45 backdrop-blur-[2px] md:hidden [[data-theme='light']_&]:bg-zinc-950/25 [&[hidden]]:hidden"
      hidden
    ></div>

    <main>
      <slot />
    </main>

    <footer class="mt-24 overflow-hidden border-t border-border-subtle bg-void pt-10">
      <div class="container flex flex-wrap items-center justify-between gap-5 pb-9">
        <div class="flex flex-wrap items-center gap-2.5 font-mono text-[13px]">
          <span class="font-medium text-fg">elemental-kit</span>
          <span class="text-fg-muted">/</span>
          <span class="tabular text-fg-muted">Rust {SDK_META.minRustVersion}+ · Edition {SDK_META.rustEdition} · {SDK_META.license}</span>
        </div>
        <div class="flex flex-wrap items-center gap-5 text-[13px] text-fg-secondary [&_a]:transition-colors [&_a:hover]:text-fg">
          <a href={withBase('/docs/')}>Documentation</a>
          <a href={withBase('/docs/architecture/launch-flow/')}>Launch Flow</a>
          <a href={withBase('/docs/migration/0.3/')}>0.3 Migration</a>
          <a href={SDK_META.docsRsUrl} target="_blank" rel="noreferrer">docs.rs</a>
          <a href={SDK_META.repositoryUrl} target="_blank" rel="noreferrer">Repository</a>
        </div>
      </div>

      <div class="pointer-events-none overflow-hidden border-t border-border-subtle pt-[18px] select-none" aria-hidden="true">
        <div class="container">
          <div class="-mb-[0.1em] bg-[linear-gradient(180deg,var(--wordmark-start)_0%,var(--wordmark-mid)_58%,var(--wordmark-end)_100%)] bg-clip-text text-center text-[clamp(56px,14.5vw,208px)] leading-[0.82] font-[620] tracking-[-0.055em] whitespace-nowrap text-transparent">
            ELEMENTAL
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Theme toggle & system preference sync
      const THEME_STORAGE_KEY = 'elemental-theme';
      const themeToggle = document.getElementById('theme-toggle');
      const themeColorMeta = document.getElementById('theme-color-meta');

      const applyTheme = (theme: 'light' | 'dark', persist: boolean) => {
        document.documentElement.dataset.theme = theme;
        if (themeColorMeta) {
          themeColorMeta.setAttribute('content', theme === 'light' ? '#fafafa' : '#090909');
        }
        if (persist) {
          try {
            localStorage.setItem(THEME_STORAGE_KEY, theme);
          } catch {
            // ignore storage access errors
          }
        }
        window.dispatchEvent(new CustomEvent('elemental-theme-change', { detail: { theme } }));
      };

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          applyTheme(current === 'light' ? 'dark' : 'light', true);
        });
      }

      if (window.matchMedia) {
        const mediaQuery = window.matchMedia('(prefers-color-scheme: light)');
        mediaQuery.addEventListener('change', (event) => {
          let hasExplicit = false;
          try {
            const saved = localStorage.getItem(THEME_STORAGE_KEY);
            hasExplicit = saved === 'light' || saved === 'dark';
          } catch {
            hasExplicit = false;
          }
          if (!hasExplicit) {
            applyTheme(event.matches ? 'light' : 'dark', false);
          }
        });
      }

      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -32px 0px' },
        );
        revealEls.forEach((el) => obs.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Mobile navigation menu
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      const mobileNavBackdrop = document.getElementById('mobile-nav-backdrop');

      if (mobileMenuToggle && mobileNav && mobileNavBackdrop) {
        const setMobileMenuOpen = (open: boolean) => {
          mobileMenuToggle.setAttribute('aria-expanded', String(open));
          mobileNav.hidden = !open;
          mobileNavBackdrop.hidden = !open;
        };

        mobileMenuToggle.addEventListener('click', () => {
          const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          setMobileMenuOpen(!isOpen);
        });

        mobileNavBackdrop.addEventListener('click', () => {
          setMobileMenuOpen(false);
        });

        mobileNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            setMobileMenuOpen(false);
          });
        });

        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileMenuToggle.getAttribute('aria-expanded') === 'true') {
            setMobileMenuOpen(false);
            mobileMenuToggle.focus();
          }
        });

        if (window.matchMedia) {
          const desktopQuery = window.matchMedia('(min-width: 769px)');
          desktopQuery.addEventListener('change', (event) => {
            if (event.matches) {
              setMobileMenuOpen(false);
            }
          });
        }
      }

      // Live GitHub star count with 10-minute sessionStorage cache
      const starWraps = Array.from(document.querySelectorAll<HTMLElement>('[data-gh-star-wrap]'));
      const starCounts = Array.from(document.querySelectorAll<HTMLElement>('[data-gh-star-count]'));
      if (starWraps.length > 0 && starCounts.length > 0) {
        const formatStars = (n: number): string =>
          n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);

        const applyStars = (n: number) => {
          const formatted = formatStars(n);
          for (const el of starCounts) {
            el.textContent = formatted;
          }
          for (const wrap of starWraps) {
            wrap.hidden = false;
          }
        };

        const cacheKey = 'elemental_gh_stars_v1';
        let cached: { count: number; ts: number } | null = null;
        try {
          const raw = sessionStorage.getItem(cacheKey);
          if (raw) cached = JSON.parse(raw);
        } catch {
          // ignore storage access errors
        }

        if (cached && typeof cached.count === 'number' && Date.now() - cached.ts < 600_000) {
          applyStars(cached.count);
        } else {
          fetch('https://api.github.com/repos/ElectronicWave/Elemental', {
            headers: { Accept: 'application/vnd.github+json' },
          })
            .then((res) => (res.ok ? res.json() : null))
            .then((data) => {
              if (data && typeof data.stargazers_count === 'number') {
                applyStars(data.stargazers_count);
                try {
                  sessionStorage.setItem(
                    cacheKey,
                    JSON.stringify({ count: data.stargazers_count, ts: Date.now() }),
                  );
                } catch {
                  // ignore storage quota errors
                }
              }
            })
            .catch(() => {
              // stay gracefully hidden when offline
            });
        }
      }
    </script>
  </body>
</html>
