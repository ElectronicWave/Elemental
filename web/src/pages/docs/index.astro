---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { groupDocs, sortDocs } from '../../lib/docs';
import { withBase } from '../../lib/paths';

const allDocs = sortDocs(await getCollection('docs'));
const groups = groupDocs(allDocs);
---

<DocsLayout
  title="Documentation"
  description="Architecture guides, launch flow specifications, refactoring principles, and migration references for Elemental."
  groups={groups}
>
  <div>
    <span class="section-index">REPOSITORY // ./docs</span>
    <h1 class="mt-3 mb-3.5 text-[clamp(28px,3.6vw,38px)] font-medium tracking-[-0.025em]">Elemental Documentation</h1>
    <p class="mb-9 max-w-[62ch] text-[15.5px] leading-[1.7] text-fg-secondary">
      Every document below is loaded directly from <code>./docs</code> at build time. Updates to
      markdown files, Mermaid diagrams, or migration guides in the repository appear here automatically.
    </p>

    {groups.map((group) => (
      <section class="mb-9">
        <h2 class="mt-0 mb-3.5 border-t-0 pt-0 font-mono text-[13px] text-accent">{group.name}</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {group.items.map((doc) => (
            <a
              href={withBase(`/docs/${doc.slug}/`)}
              class="corner-frame flex flex-col gap-2 p-5 no-underline transition-colors hover:border-accent-border hover:bg-raised"
            >
              <div class="flex items-center justify-between font-mono text-[11.5px] text-fg-muted">
                <span>docs/{doc.slug}.md</span>
                <span class="tabular">{doc.readingMinutes} min</span>
              </div>
              <h3 class="m-0 text-[17px] font-medium text-fg">{doc.title}</h3>
              <p class="m-0 text-[13.5px] leading-[1.55] text-fg-secondary">{doc.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</DocsLayout>
