---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { DocGroup, DocMeta } from '../lib/docs';
import { SDK_META } from '../data/sdk';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  groups: readonly DocGroup[];
  activeSlug?: string;
  headings?: readonly MarkdownHeading[];
  prevDoc?: DocMeta | null;
  nextDoc?: DocMeta | null;
  sourcePath?: string;
  readingMinutes?: number;
  hasMermaid?: boolean;
}

const {
  title,
  description,
  groups,
  activeSlug,
  headings = [],
  prevDoc = null,
  nextDoc = null,
  sourcePath,
  readingMinutes,
  hasMermaid = false,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description} activeNav="docs">
  <div class="container docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <div class="sidebar-sticky">
        <a href={withBase('/docs/')} class:list={['sidebar-overview', { active: !activeSlug }]}>
          Documentation Home
        </a>

        {groups.map((group) => (
          <div class="sidebar-group">
            <div class="sidebar-group-title">{group.name}</div>
            <ul class="sidebar-list">
              {group.items.map((item) => (
                <li>
                  <a
                    href={withBase(`/docs/${item.slug}/`)}
                    class:list={['sidebar-link', { active: activeSlug === item.slug }]}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="sidebar-group">
          <div class="sidebar-group-title">External References</div>
          <ul class="sidebar-list">
            <li>
              <a href={SDK_META.docsRsUrl} target="_blank" rel="noreferrer" class="sidebar-link">
                API Reference (docs.rs)
              </a>
            </li>
            <li>
              <a
                href={`${SDK_META.repositoryUrl}/blob/main/crates/shared/DESIGN.md`}
                target="_blank"
                rel="noreferrer"
                class="sidebar-link"
              >
                Persistence Design
              </a>
            </li>
            <li>
              <a
                href={`${SDK_META.repositoryUrl}/blob/main/crates/object/DESIGN.md`}
                target="_blank"
                rel="noreferrer"
                class="sidebar-link"
              >
                Object Pool Design
              </a>
            </li>
          </ul>
        </div>
      </div>
    </aside>

    <article class="docs-content">
      {sourcePath && (
        <div class="doc-meta-strip">
          <span class="doc-source-badge">docs/{sourcePath}.md</span>
          <div class="doc-meta-right">
            {readingMinutes && <span class="tabular">{readingMinutes} min read</span>}
            <a
              href={`${SDK_META.repositoryUrl}/blob/main/docs/${sourcePath}.md`}
              target="_blank"
              rel="noreferrer"
              class="doc-gh-link"
            >
              View source on GitHub
            </a>
          </div>
        </div>
      )}

      <div class="prose">
        <slot />
      </div>

      {(prevDoc || nextDoc) && (
        <nav class="doc-pager" aria-label="Document pagination">
          {prevDoc ? (
            <a href={withBase(`/docs/${prevDoc.slug}/`)} class="pager-card corner-frame">
              <span class="pager-label">Previous</span>
              <span class="pager-title">{prevDoc.title}</span>
            </a>
          ) : (
            <div />
          )}

          {nextDoc ? (
            <a href={withBase(`/docs/${nextDoc.slug}/`)} class="pager-card pager-next corner-frame">
              <span class="pager-label">Next</span>
              <span class="pager-title">{nextDoc.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )}
    </article>

    {tocHeadings.length > 0 && (
      <aside class="docs-toc" aria-label="Table of contents">
        <div class="toc-sticky">
          <div class="toc-title">On this page</div>
          <ul class="toc-list">
            {tocHeadings.map((h) => (
              <li class:list={['toc-item', { 'toc-sub': h.depth === 3 }]}>
                <a href={`#${h.slug}`} class="toc-link">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>

  {hasMermaid && (
    <script>
      const mermaidBlocks = Array.from(
        document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]'),
      );

      if (mermaidBlocks.length > 0) {
        const renderDiagrams = async () => {
          if (document.fonts?.ready) {
            await document.fonts.ready;
          }
          const { default: mermaid } = await import('mermaid');
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            themeVariables: {
              darkMode: true,
              background: '#050505',
              primaryColor: '#121212',
              primaryTextColor: '#f5f5f5',
              primaryBorderColor: '#ffffff',
              lineColor: '#737373',
              secondaryColor: '#1a1a1a',
              tertiaryColor: '#101010',
              fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
              fontSize: '13px',
            },
            flowchart: {
              htmlLabels: true,
              curve: 'basis',
              padding: 18,
              nodeSpacing: 44,
              rankSpacing: 48,
            },
          });

          await Promise.all(
            mermaidBlocks.map(async (pre, i) => {
              const source = pre.textContent?.trim() ?? '';
              if (!source) return;
              try {
                const { svg } = await mermaid.render(`mermaid-graph-${i}`, source);
                const wrapper = document.createElement('div');
                wrapper.className = 'mermaid-frame corner-frame';
                wrapper.innerHTML = svg;
                pre.replaceWith(wrapper);
              } catch {
                // Keep original code block if Mermaid fails to parse
              }
            }),
          );
        };

        void renderDiagrams();
      }
    </script>
  )}
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 220px;
    gap: 40px;
    padding-top: 36px;
    align-items: start;
  }

  .sidebar-sticky,
  .toc-sticky {
    position: sticky;
    top: calc(var(--nav-height) + 28px);
    max-height: calc(100vh - var(--nav-height) - 48px);
    overflow-y: auto;
  }

  .sidebar-overview {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .sidebar-overview:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .sidebar-overview.active {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: var(--accent-border);
  }

  .sidebar-group {
    margin-top: 24px;
  }

  .sidebar-group-title {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
    padding: 0 12px 8px;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    display: block;
    padding: 7px 12px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    color: var(--text-secondary);
    border: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .sidebar-link.active {
    color: var(--text-primary);
    background: var(--bg-raised);
    border-color: var(--accent-border);
  }

  .docs-content {
    min-width: 0;
  }

  .doc-meta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .doc-source-badge {
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  .doc-meta-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .doc-gh-link {
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .doc-gh-link:hover {
    color: var(--accent);
  }

  /* Prose styling for ./docs markdown */
  .prose :global(h1) {
    margin: 0 0 20px;
    font-size: clamp(28px, 3.6vw, 38px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .prose :global(h2) {
    margin: 44px 0 14px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    scroll-margin-top: calc(var(--nav-height) + 24px);
  }

  .prose :global(h3) {
    margin: 28px 0 10px;
    font-size: 17px;
    font-weight: 500;
    color: var(--text-primary);
    scroll-margin-top: calc(var(--nav-height) + 24px);
  }

  .prose :global(p) {
    margin: 0 0 16px;
    font-size: 15.5px;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.7;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--accent-soft);
  }

  .prose :global(:not(pre) > code) {
    font-size: 13px;
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }

  .prose :global(pre) {
    margin: 0 0 22px;
  }

  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 14px 18px;
    border-left: 3px solid var(--accent);
    background: var(--bg-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 24px;
    font-size: 13.5px;
    display: block;
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
  }

  .prose :global(th) {
    text-align: left;
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-void);
    border-bottom: 1px solid var(--border-subtle);
  }

  .prose :global(td) {
    padding: 10px 14px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(.mermaid-frame) {
    margin: 0 0 24px;
    padding: 20px;
    background: var(--bg-void);
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }

  .prose :global(.mermaid-frame svg) {
    max-width: 100%;
    height: auto;
  }

  /* Pagination */
  .doc-pager {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pager-card {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .pager-card:hover {
    border-color: var(--accent-border);
  }

  .pager-next {
    text-align: right;
  }

  .pager-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .pager-title {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text-primary);
  }

  /* TOC */
  .toc-title {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .toc-link {
    display: block;
    padding: 2px 0 2px 12px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .toc-sub .toc-link {
    padding-left: 22px;
  }

  .toc-link:hover {
    color: var(--accent);
  }

  @media (max-width: 1120px) {
    .docs-shell {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .docs-toc {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .docs-shell {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .sidebar-sticky {
      position: static;
      max-height: none;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .doc-pager {
      grid-template-columns: 1fr;
    }
  }
</style>
