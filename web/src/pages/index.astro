---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VoxelLatticeCanvas from '../components/VoxelLatticeCanvas.astro';
import HeroCodeShowcase from '../components/HeroCodeShowcase.astro';
import CargoBuilder from '../components/CargoBuilder.astro';
import { DRIVER_FAMILIES, SDK_META, WORKSPACE_CRATES } from '../data/sdk';
import { sortDocs } from '../lib/docs';
import { highlightShellBlock, highlightShellLine } from '../lib/highlight';
import { withBase } from '../lib/paths';

const allDocs = sortDocs(await getCollection('docs'));
const architectureDocs = allDocs.filter((d) => !d.slug.startsWith('migration/'));
const migrationDocs = allDocs.filter((d) => d.slug.startsWith('migration/'));

const layerLabels: Record<string, string> = {
  facade: 'Facade',
  orchestration: 'Orchestration',
  domain: 'Domain',
  foundation: 'Foundation',
  binary: 'CLI Binary',
};

const launchpadSetupRaw = `git clone https://github.com/ElectronicWave/Elemental.git && cd Elemental
cargo run -p launchpad`;

const launchpadSetupHtml = highlightShellBlock(launchpadSetupRaw);
---

<BaseLayout title={SDK_META.name} activeNav="home">
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-border-subtle py-12 md:pt-[76px] md:pb-[68px]">
    <VoxelLatticeCanvas />
    <div class="container relative z-10 grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,0.94fr)_minmax(0,1.06fr)] lg:gap-12">
      <div class="flex flex-col gap-6">
        <div class="tabular inline-flex items-center gap-2.5 font-mono text-[12.5px] text-fg-secondary">
          <span>elemental-kit {SDK_META.version}</span>
          <span class="size-1 rounded-full bg-fg" aria-hidden="true"></span>
          <span>Rust {SDK_META.minRustVersion}+ · Edition {SDK_META.rustEdition}</span>
        </div>

        <h1 class="m-0 max-w-[16ch] text-[clamp(36px,4.6vw,56px)] leading-[1.08] font-[420] tracking-[-0.035em] text-[var(--hero-dim)]">
          Every{' '}
          <span class="relative inline-block border-b-[1.5px] border-[var(--hero-key-border)] pb-0.5 font-[620] text-fg">
            element
          </span>{' '}
          of a <span class="font-[580] text-fg">Minecraft launcher</span>, in{' '}
          <span class="font-[580] text-fg">Rust</span>.
        </h1>

        <p class="m-0 max-w-[48ch] text-[16.5px] leading-[1.65] text-fg-secondary [&_code]:rounded [&_code]:border [&_code]:border-border-subtle [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-px [&_code]:text-sm [&_code]:whitespace-nowrap [&_code]:text-fg">
          Discover versions, prepare modded instances, resolve local Java runtimes, and spawn the JVM
          through one async <code>Send + Sync</code> interface — or adopt the persistence, object-pool,
          and download crates independently.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href={withBase('/#getting-started')} class="btn btn-primary">
            Get started
          </a>
          <a href={withBase('/docs/architecture/launch-flow/')} class="btn btn-secondary">
            Inspect launch flow
          </a>
        </div>

        <dl class="mt-3 grid grid-cols-2 gap-4 border-t border-border-subtle pt-6 md:grid-cols-4">
          <div class="flex flex-col-reverse gap-1">
            <dt class="text-xs text-fg-muted">Built-in drivers</dt>
            <dd class="tabular m-0 font-mono text-[17px] font-medium whitespace-nowrap text-fg">11</dd>
          </div>
          <div class="flex flex-col-reverse gap-1">
            <dt class="text-xs text-fg-muted">Workspace crates</dt>
            <dd class="tabular m-0 font-mono text-[17px] font-medium whitespace-nowrap text-fg">9</dd>
          </div>
          <div class="flex flex-col-reverse gap-1">
            <dt class="text-xs text-fg-muted">Auth providers</dt>
            <dd class="tabular m-0 font-mono text-[17px] font-medium whitespace-nowrap text-fg">3</dd>
          </div>
          <div class="flex flex-col-reverse gap-1">
            <dt class="text-xs text-fg-muted">Async futures</dt>
            <dd class="tabular m-0 font-mono text-[17px] font-medium whitespace-nowrap text-fg">Send + Sync</dd>
          </div>
        </dl>
      </div>

      <div class="min-w-0">
        <HeroCodeShowcase />
      </div>
    </div>
  </section>

  <!-- 01 // GETTING STARTED -->
  <section class="reveal pt-24" id="getting-started">
    <div class="container">
      <div class="mb-8 flex max-w-[680px] flex-col gap-3">
        <span class="section-index">01 // GETTING STARTED</span>
        <h2 class="m-0 text-[clamp(26px,3.2vw,36px)] leading-[1.14] font-medium tracking-[-0.025em] text-fg">
          Add elemental-kit to your Cargo.toml.
        </h2>
        <p class="m-0 text-[15px] leading-[1.65] text-fg-secondary">
          Requires Rust {SDK_META.minRustVersion}+ (Edition {SDK_META.rustEdition}) and a local Java runtime.
          Pick the exact modules, forwarded features, and TLS backend your application needs.
        </p>
      </div>

      <CargoBuilder />
    </div>
  </section>

  <!-- 02 // TRY LAUNCHPAD DEMO -->
  <section class="reveal pt-24" id="launchpad">
    <div class="container">
      <div class="mb-8 flex max-w-[680px] flex-col gap-3">
        <span class="section-index">02 // LAUNCHPAD DEMO</span>
        <h2 class="m-0 text-[clamp(26px,3.2vw,36px)] leading-[1.14] font-medium tracking-[-0.025em] text-fg">
          Try our launchpad CLI across every loader.
        </h2>
        <p class="m-0 text-[15px] leading-[1.65] text-fg-secondary [&_code]:rounded [&_code]:border [&_code]:border-border-subtle [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-px [&_code]:text-[13.5px] [&_code]:text-fg">
          <code>launchpad</code> is our reference CLI built directly on <code>elemental-kit</code>.
          Run it with no arguments to open the interactive setup wizard, or pass any of the 11 supported
          drivers below to prepare and launch directly from your terminal.
        </p>
      </div>

      <div class="corner-frame mb-5 overflow-hidden bg-void">
        <div class="flex items-center justify-between gap-3 border-b border-border-subtle bg-surface px-[18px] py-[11px]">
          <div class="flex items-center gap-2.5">
            <span class="rounded border border-border-default bg-void px-[7px] py-px font-mono text-[11px] text-fg">sh</span>
            <span class="text-[13.5px] font-medium text-fg">Clone workspace & launch interactive wizard</span>
          </div>
          <button
            type="button"
            class="h-7 shrink-0 cursor-pointer rounded border border-border-default bg-void px-[11px] font-mono text-[11.5px] text-fg-secondary transition-colors hover:border-border-strong hover:text-fg"
            data-copy-raw={launchpadSetupRaw}
          >
            Copy
          </button>
        </div>
        <pre class="m-0 overflow-x-auto px-5 py-4 text-[13px] leading-[1.7]"><code set:html={launchpadSetupHtml} /></pre>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {DRIVER_FAMILIES.map((family) => (
          <article class="corner-frame flex min-w-0 flex-col gap-4 p-6 transition-colors hover:border-border-strong hover:bg-raised">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="m-0 text-lg font-medium text-fg">{family.name}</h3>
                <span class="mt-0.5 inline-block font-mono text-xs text-fg-muted">{family.familyLabel}</span>
              </div>
              <span class="tabular shrink-0 rounded border border-border-default bg-void px-[9px] py-[3px] font-mono text-xs text-fg">
                Java {family.javaMajor}
              </span>
            </div>

            <p class="m-0 text-sm leading-[1.6] text-fg-secondary">{family.summary}</p>

            <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0" aria-label={`${family.name} drivers`}>
              {family.drivers.map((drv) => (
                <li class="rounded border border-border-subtle bg-void px-[9px] py-[3px] font-mono text-xs text-fg">
                  {drv}
                </li>
              ))}
            </ul>

            <div class="mt-auto flex min-w-0 items-center gap-2 rounded-lg border border-border-subtle bg-void py-1.5 pr-2 pl-3">
              <div class="min-w-0 flex-1 overflow-x-auto py-0.5">
                <code class="text-xs whitespace-nowrap" set:html={highlightShellLine(`$ ${family.cliCommand}`)} />
              </div>
              <button
                type="button"
                class="h-7 shrink-0 cursor-pointer rounded border border-border-default bg-void px-[11px] font-mono text-[11.5px] text-fg-secondary transition-colors hover:border-border-strong hover:text-fg"
                data-copy-raw={family.cliCommand}
                aria-label={`Copy ${family.name} launchpad command`}
              >
                Copy
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 // MODULAR CRATES (OPT-IN ARCHITECTURE) -->
  <section class="reveal pt-24" id="crates">
    <div class="container">
      <div class="mb-8 flex max-w-[680px] flex-col gap-3">
        <span class="section-index">03 // MODULAR ARCHITECTURE</span>
        <h2 class="m-0 text-[clamp(26px,3.2vw,36px)] leading-[1.14] font-medium tracking-[-0.025em] text-fg">
          Modular by design. Enable only what you need.
        </h2>
        <p class="m-0 text-[15px] leading-[1.65] text-fg-secondary [&_code]:rounded [&_code]:border [&_code]:border-border-subtle [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-px [&_code]:text-[13.5px] [&_code]:text-fg">
          Every capability is isolated into its own crate and gated behind explicit Cargo features.
          Turn off <code>default-features</code> to compile a minimal launcher stack—or adopt standalone
          foundation crates like persistence, object pools, and download sessions in any Rust app.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {WORKSPACE_CRATES.map((crate) => (
          <a
            href={crate.readmeUrl}
            target="_blank"
            rel="noreferrer"
            class="corner-frame flex flex-col gap-3.5 p-5 transition-[border-color,background-color,transform] hover:-translate-y-0.5 hover:border-border-strong hover:bg-raised"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="tabular font-mono text-xs text-fg-muted">{crate.atomicNumber}</span>
              <span
                class:list={[
                  'inline-block rounded border bg-void px-2 py-0.5 font-mono text-[11px] whitespace-nowrap',
                  crate.layer === 'facade'
                    ? 'border-border-strong text-fg'
                    : 'border-border-subtle text-fg-secondary',
                ]}
              >
                {layerLabels[crate.layer]}
              </span>
            </div>
            <div class="flex items-center gap-3.5">
              <span
                class:list={[
                  'inline-flex size-11 shrink-0 items-center justify-center rounded-lg border font-mono text-lg font-semibold',
                  crate.layer === 'facade'
                    ? 'border-fg bg-fg text-void'
                    : 'border-border-default bg-void text-fg',
                ]}
              >
                {crate.symbol}
              </span>
              <div class="flex min-w-0 flex-col gap-0.5">
                <span class="font-mono text-sm font-medium text-fg">{crate.name}</span>
                <span class="truncate font-mono text-[11.5px] text-fg-muted">
                  {crate.modulePath ?? 'workspace binary'}
                </span>
              </div>
            </div>
            <p class="m-0 text-[13.5px] leading-[1.58] text-fg-secondary">{crate.purpose}</p>
            <div class="mt-auto border-t border-border-subtle pt-2.5">
              <code class="text-[11.5px] text-fg-muted">
                {crate.feature ? `feature = "${crate.feature}"` : 'cargo run -p launchpad'}
              </code>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
        <div class="corner-frame flex flex-col gap-3 p-6">
          <h3 class="m-0 text-base font-medium text-fg">Opt-in auth & local testing features</h3>
          <p class="m-0 text-sm leading-[1.65] text-fg-secondary [&_code]:text-[12.5px] [&_code]:text-fg">
            <code>OfflineAuthorizer</code>, <code>MicrosoftAuthorizer</code>, and
            <code>YggdrasilAuthorizer</code> share one <code>Authorizer</code> contract. Enable
            <code>yggdrasil-auth</code> or <code>offline-server</code> only when your launcher needs them.
          </p>
          <div class="mt-1 flex flex-wrap gap-1.5 [&_code]:rounded [&_code]:border [&_code]:border-border-default [&_code]:bg-void [&_code]:px-2 [&_code]:py-[3px] [&_code]:text-[11.5px] [&_code]:text-fg">
            <code>yggdrasil-auth</code>
            <code>offline-server</code>
            <code>AccountStore</code>
          </div>
        </div>

        <div class="corner-frame flex flex-col gap-3 p-6">
          <h3 class="m-0 text-base font-medium text-fg">Pluggable storage & layout compatibility</h3>
          <p class="m-0 text-sm leading-[1.65] text-fg-secondary [&_code]:text-[12.5px] [&_code]:text-fg">
            Swap storage layouts via <code>Storage&lt;L&gt;</code> or keep default probing that preserves
            Elemental, Prism, PCL, and XMCL layouts without overwriting user-modified libraries.
          </p>
          <div class="mt-1 flex flex-wrap gap-1.5 [&_code]:rounded [&_code]:border [&_code]:border-border-default [&_code]:bg-void [&_code]:px-2 [&_code]:py-[3px] [&_code]:text-[11.5px] [&_code]:text-fg">
            <code>Storage&lt;L&gt;</code>
            <code>--local-only</code>
            <code>DriverRegistration</code>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 // ARCHITECTURE & DOCUMENTATION -->
  <section class="reveal pt-24" id="documentation">
    <div class="container">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-[680px] flex-col gap-3">
          <span class="section-index">04 // ARCHITECTURE & DOCS</span>
          <h2 class="m-0 text-[clamp(26px,3.2vw,36px)] leading-[1.14] font-medium tracking-[-0.025em] text-fg">
            How Elemental works under the hood.
          </h2>
          <p class="m-0 text-[15px] leading-[1.65] text-fg-secondary [&_code]:rounded [&_code]:border [&_code]:border-border-subtle [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-px [&_code]:text-[13.5px] [&_code]:text-fg">
            Read the end-to-end launch pipeline specification and engineering principles directly from
            <code>./docs</code>, complete with Mermaid state diagrams and source references.
          </p>
        </div>
        <a href={withBase('/docs/')} class="btn btn-secondary btn-sm">
          Browse all docs ({allDocs.length})
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {architectureDocs.map((doc) => (
          <a
            href={withBase(`/docs/${doc.slug}/`)}
            class="corner-frame flex flex-col gap-2.5 p-6 transition-colors hover:border-border-strong hover:bg-raised"
          >
            <div class="flex items-center justify-between font-mono text-xs">
              <span class="text-fg">{doc.group}</span>
              <span class="tabular text-fg-muted">{doc.readingMinutes} min read</span>
            </div>
            <h3 class="m-0 text-lg font-medium text-fg">{doc.title}</h3>
            <p class="m-0 text-sm leading-[1.6] text-fg-secondary">{doc.description}</p>
            <span class="mt-auto pt-2 font-mono text-xs text-fg-muted">docs/{doc.slug}.md</span>
          </a>
        ))}
      </div>

      {migrationDocs.length > 0 && (
        <div class="corner-frame mt-5 flex flex-wrap items-center justify-between gap-5 px-6 py-[18px]">
          <div class="flex flex-col gap-0.5">
            <span class="text-sm font-medium text-fg">Upgrading from an earlier release?</span>
            <span class="text-[13px] text-fg-muted">Breaking-change tables and API migration notes</span>
          </div>
          <div class="flex flex-wrap items-center gap-2.5">
            {migrationDocs.map((doc) => (
              <a
                href={withBase(`/docs/${doc.slug}/`)}
                class="inline-flex items-center gap-2 rounded-lg border border-border-default bg-void px-3 py-[7px] font-mono text-[12.5px] text-fg-secondary transition-colors hover:border-border-strong hover:text-fg"
              >
                <span>{doc.title}</span>
                <span class="text-fg-muted" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-copy-raw]'));
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const raw = btn.dataset.copyRaw ?? '';
      if (!raw) return;
      const original = btn.textContent ?? 'Copy';
      try {
        await navigator.clipboard.writeText(raw);
        btn.textContent = 'Copied';
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      } catch {
        btn.textContent = 'Select';
      }
    });
  });
</script>
